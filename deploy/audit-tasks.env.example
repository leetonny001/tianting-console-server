# 只给 audit verify 和 audit archive（deploy/console-audit-*.service）。权限 0600，不要配给 console-server.service。
# 读取外部锚定：能列举和读，不能写、不能删。没有这份凭证时生产环境的 verify 拒绝运行。
CON_AUDIT_ANCHOR_READ_ACCESS_KEY=CHANGE_ME
CON_AUDIT_ANCHOR_READ_SECRET_KEY=CHANGE_ME
# 日志平台形式的锚定用这个：CON_AUDIT_ANCHOR_READ_TOKEN=CHANGE_ME
# 归档：和锚定不是同一个桶，开启 Object Lock。凭证要能写和读（读回核对密文哈希），不能删。
CON_AUDIT_ARCHIVE=s3://console-audit-archive
CON_AUDIT_ARCHIVE_ENDPOINT=https://s3.example.internal
CON_AUDIT_ARCHIVE_ACCESS_KEY=CHANGE_ME
CON_AUDIT_ARCHIVE_SECRET_KEY=CHANGE_ME
CON_AUDIT_ARCHIVE_YEARS=3
# age 公钥。私钥线下保存，只有恢复归档时才用。
CON_ARCHIVE_RECIPIENT=age1CHANGE_ME
CON_ARCHIVER_DATABASE_URL=postgres://console_archiver:CHANGE_ME@db.internal/console
