# console-server 配置示例（PRD-admin F-CON-01）。真实密钥放在 0600 的文件里，不进仓库。
CON_ENV=production
CON_SPACES=admin,ops
CON_ADMIN_ADDR=10.0.0.5:8090
CON_OPS_ADDR=10.0.0.5:8091
CON_ADMIN_ORIGIN=https://admin.console.example.internal
CON_OPS_ORIGIN=https://ops.console.example.internal
CON_ADMIN_ALLOWED_CIDRS=10.8.0.0/16
CON_OPS_ALLOWED_CIDRS=10.8.2.0/24
CON_TRUSTED_PROXIES=10.0.0.2
# 运行账号 console_app；迁移账号 console_owner 只在 migrate 时使用
CON_DATABASE_URL=postgres://console_app:CHANGE_ME@db.internal/console
CON_OWNER_DATABASE_URL=postgres://console_owner:CHANGE_ME@db.internal/console
# kid:base64（至少 32 字节随机），轮换时两把同时存在，再运行 console-server keys rotate
CON_DATA_KEYS=k1:CHANGE_ME
CON_DATA_ACTIVE_KID=k1
CON_HASH_PEPPER=CHANGE_ME
# Ed25519 种子或私钥（base64），公钥配到 im-server 的 IM_ADMIN_CALLERS
CON_IM_ADMIN_URL=https://im-admin.internal:8081
CON_IM_SIGNING_KEY=CHANGE_ME
# 审计外部锚定：s3://桶/前缀（必须开启 Object Lock），或日志平台的 https:// 地址（POST 写入，用 CON_AUDIT_ANCHOR_TOKEN）。
# 这份凭证只能写，不能读、不能删。读取凭证放 audit-tasks.env。
CON_AUDIT_ANCHOR=s3://console-audit-anchor
CON_AUDIT_ANCHOR_ENDPOINT=https://s3.example.internal
CON_AUDIT_ANCHOR_ACCESS_KEY=CHANGE_ME
CON_AUDIT_ANCHOR_SECRET_KEY=CHANGE_ME
# im-server 调用方要有 scope audit.read（审计详情的跳转和对账都要用）
# 运维模块（PRD-ops）。节点凭证表是 JSON 数组：[{nodeId, addr, tlsServerName, kid, keyFile, metricsAddr}]，
# keyFile 是 0600 的文件，内容是 base64 的 Ed25519 种子；节点上配对应公钥 IM_OPS_PUBKEYS。轮换：节点先配两把公钥，再换这里的 keyFile 重启。
CON_OPS_NODES=/etc/tianting/ops-nodes.json
CON_OPS_CA_FILE=/etc/tianting/internal-ca.pem
CON_OPS_PROMETHEUS_URL=http://127.0.0.1:9090
CON_OPS_ALERTMANAGER_URL=http://127.0.0.1:9093
# 备份清单：这份凭证只能列出和读取 manifests/。对象键 manifests/{source}/{finishedAt 毫秒，补零到 13 位}.json
CON_OPS_BACKUP_STORE=s3://tianting-backups
CON_OPS_BACKUP_ENDPOINT=https://s3.example.internal
CON_OPS_BACKUP_ACCESS_KEY=CHANGE_ME
CON_OPS_BACKUP_SECRET_KEY=CHANGE_ME
# Grafana 只对 console-server 开放；浏览器通过这个主机名访问，同一个进程按 Host 分流
CON_OPS_GRAFANA_URL=http://127.0.0.1:3000
CON_OPS_GRAFANA_HOST=grafana.ops.example.internal
